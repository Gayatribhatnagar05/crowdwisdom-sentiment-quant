# ==============================================================================
# CrowdWisdomTrading - X Sentiment Price Prediction Agent Environment Config
# ==============================================================================

# Apify API Token (Get one at https://console.apify.com/account/integrations)
APIFY_API_TOKEN=your_apify_api_token_here

# Apify Actor ID for Twitter/X Scraping
# Options:
# - apidojo/tweet-scraper (Recommended: comprehensive tweet details & engagement)
# - kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest (Cost-effective)
# - microworlds/twitter-scraper
APIFY_TWITTER_ACTOR_ID=apidojo/tweet-scraper

# Tavily AI Search API Key (Get free key at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Exa AI Search API Key (Optional alternative news ingestion)
EXA_API_KEY=your_exa_api_key_here

# Target Asset Configuration
ASSET_TICKER=TSLA
ASSET_NAME=Tesla
ASSET_CASHTAG=$TSLA
ASSET_KEYWORDS=Tesla,Elon Musk TSLA,Tesla earnings,Tesla stock

# Ingestion Window
DAYS_BACK=180
TIME_INTERVAL=1h # Options: 1h, 4h, 1d (Hourly bars provide rich intraday sentiment alignment)

# Storage
DATABASE_PATH=data/crowdwisdom.db

# Random Seed for Reproducibility
RANDOM_STATE=42
